<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="camera_maze_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"></plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <pose>0.00 0.00 0 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>10.0 10.0</size></plane></geometry>
        </collision>
        <visual name="visual">
          <pose>0.00 0.00 0 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>10.0 10.0</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Robot spawn marker: a flat green square showing exactly where the
         robot should be spawned. -->
    <model name="robot_spawn_marker">
      <static>true</static>
      <pose>-3.125 -3.125 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.02</size></box></geometry>
          <material>
            <ambient>0.1 0.9 0.1 1</ambient>
            <diffuse>0.1 0.9 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- MAZE LAYOUT:  -->

    <!-- Outer walls -->

    <model name="wall_west">
      <static>true</static>
      <pose>-3.75 0.00 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 7.50 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 7.50 1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>3.75 0.00 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 7.50 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 7.50 1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Back wall (North) with exit opening near corner where red cube was located -->
    <model name="wall_north">
      <static>true</static>
      <pose>-0.625 3.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.25 0.2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>6.25 0.2 1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0.00 -3.75 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>7.50 0.2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>7.50 0.2 1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

