<?xml version="1.0"?>
<!-- equilateral triangle test room; lengths in metres, angles in radians. -->
<sdf version="1.9">
  <world name="equilateral_triangle">
    <!-- Fixed simulation step with a target real-time factor of one. -->
    <physics name="room_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Physics, spawning, scene updates and rendered LiDAR sensor support. -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- Centre the floor below zero so its top surface is at z = 0. -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <pose>0 0 -0.025 0 0 0</pose>
        <collision name="ground_collision">
          <geometry>
            <box><size>3.0 3.0 0.05</size></box>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <box><size>3.0 3.0 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Clear internal shape: equilateral triangle with 1.00 m sides.
      Wall thickness: 0.05 m
      Wall height: 0.50 m
      Ideal internal vertices:
        top   = ( 0.000000,  0.577350)
        left  = (-0.500000, -0.288675)
        right = ( 0.500000, -0.288675)
    -->
    <!-- Collision and visual boxes share geometry for contact and sensor use. -->
    <model name="equilateral_triangle_room">
      <static>true</static>

      <link name="base_wall">
        <pose>0 -0.25594 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.886603 0.05 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.886603 0.05 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.25 0.45 0.85 1</ambient>
            <diffuse>0.30 0.55 0.95 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="left_wall">
        <pose>-0.221651 0.12797 0.25 0 0 1.047198</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.886603 0.05 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.886603 0.05 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.25 0.45 0.85 1</ambient>
            <diffuse>0.30 0.55 0.95 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="right_wall">
        <pose>0.221651 0.12797 0.25 0 0 2.094395</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.886603 0.05 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.886603 0.05 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.25 0.45 0.85 1</ambient>
            <diffuse>0.30 0.55 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
