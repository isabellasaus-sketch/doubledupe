<?xml version="1.0"?>
<!-- large square test room; lengths in metres, angles in radians. -->
<sdf version="1.9">
  <world name="large_square">
    <!-- Fixed simulation step with a target real-time factor of one. -->
    <physics name="room_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <!-- Physics, spawning, scene updates and rendered LiDAR sensor support. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>
    <!-- Centre the floor below zero so its top surface is at z = 0. -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <pose>0 0 -0.025 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>3.0 3.0 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 3.0 0.05</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Internal size: 1.50 m x 1.50 m. -->
    <!-- Collision and visual boxes share geometry for contact and sensor use. -->
    <model name="large_square_room">
      <static>true</static>
      <link name="north_wall">
        <pose>0 0.475 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1 0.05 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1 0.05 0.5</size></box></geometry>
          <material>
            <ambient>0.25 0.45 0.85 1</ambient>
            <diffuse>0.30 0.55 0.95 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="south_wall">
        <pose>0 -0.475 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1 0.05 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1 0.05 0.5</size></box></geometry>
          <material>
            <ambient>0.25 0.45 0.85 1</ambient>
            <diffuse>0.30 0.55 0.95 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="east_wall">
        <pose>0.475 0 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.05 0.9 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.9 0.5</size></box></geometry>
          <material>
            <ambient>0.25 0.45 0.85 1</ambient>
            <diffuse>0.30 0.55 0.95 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="west_wall">
        <pose>-0.475 0 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.05 0.9 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.9 0.5</size></box></geometry>
          <material>
            <ambient>0.25 0.45 0.85 1</ambient>
            <diffuse>0.30 0.55 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
